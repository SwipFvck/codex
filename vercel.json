{
  "rewrites": [
    {
      "source": "/api/snippets",
      "destination": "/api/snippets.js"
    },
    {
      "source": "/",
      "destination": "/tampilan/index.html"
    },
    {
      "source": "/code",
      "destination": "/tampilan/index.html"
    },
    {
      "source": "/code/:slug",
      "destination": "/tampilan/index.html"
    }
  ]
}